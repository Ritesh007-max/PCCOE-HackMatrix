Intelligence/data/snapshots/snapshot_crawl_*.json
Intelligence/data/snapshots/rag_chunks_crawl_*.json
Intelligence/data/snapshots/reconciliation_diff.json
Intelligence/data/snapshots/candidates/
Intelligence/data/coverage/*
!Intelligence/data/coverage/.gitkeep
Intelligence/data/conflicts/*
!Intelligence/data/conflicts/.gitkeep
Intelligence/data/failures/*
!Intelligence/data/failures/.gitkeep
Intelligence/data/indexes/*
!Intelligence/data/indexes/.gitkeep
Intelligence/data/lineage/*
!Intelligence/data/lineage/.gitkeep
Intelligence/data/evaluation/reports/*
!Intelligence/data/evaluation/reports/.gitkeep
Intelligence/data/schemes/documents/*
!Intelligence/data/schemes/documents/.gitkeep
Intelligence/scratch/

# Models & Vector Stores
