{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://policysetu.ai/schemas/rule_schema.json",
  "title": "PolicySetuSchemeRuleDefinition",
  "description": "JSON Schema specification for machine-readable statutory eligibility and exclusion rules in PolicySetu.",
  "type": "object",
  "required": [
    "scheme_id",
    "scheme_slug",
    "scheme_name",
    "version",
    "root_logic",
    "rules"
  ],
  "properties": {
    "scheme_id": {
      "type": "string",
      "format": "uuid",
      "description": "Deterministic UUIDv5 matching canonical scheme ID."
    },
    "scheme_slug": {
      "type": "string",
      "description": "Unique canonical alphanumeric slug."
    },
    "scheme_name": {
      "type": "string",
      "description": "Full official name of the government scheme."
    },
    "version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Semantic version of the rule extraction specification."
    },
    "last_updated": {
      "type": "string",
      "description": "ISO-8601 timestamp of rule definition."
    },
    "root_logic": {
      "type": "string",
      "enum": ["AND", "OR"],
      "default": "AND",
      "description": "Top-level logical operator combining all mandatory logic groups."
    },
    "rules": {
      "type": "array",
      "description": "Ordered collection of atomic eligibility and exclusion rules.",
      "items": {
        "$ref": "#/definitions/Rule"
      }
    },
    "logic_groups": {
      "type": "array",
      "description": "Definitions of composite and nested logic groups.",
      "items": {
        "$ref": "#/definitions/LogicGroup"
      }
    }
  },
  "definitions": {
    "Rule": {
      "type": "object",
      "required": [
        "rule_id",
        "scheme_id",
        "rule_type",
        "field",
        "operator",
        "expected_value",
        "value_type",
        "logic_group",
        "required",
        "hard_constraint",
        "condition",
        "raw_text",
        "source_url",
        "source_document",
        "source_page",
        "source_section",
        "confidence",
        "provenance"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "Unique identifier for this rule, e.g. rule_apy_01."
        },
        "scheme_id": {
          "type": "string",
          "description": "UUID of the associated scheme."
        },
        "rule_type": {
          "type": "string",
          "enum": [
            "eligibility",
            "exclusion",
            "conditional",
            "document_requirement",
            "benefit_condition"
          ],
          "description": "Functional domain of the rule: positive qualification, formal disqualification, conditional branch, document mandate, or benefit threshold."
        },
        "field": {
          "type": "string",
          "description": "Canonical applicant profile attribute evaluated by this rule (e.g. age, annual_income, state, gender, social_category)."
        },
        "operator": {
          "type": "string",
          "enum": [
            ">=",
            ">",
            "<=",
            "<",
            "=",
            "!=",
            "between",
            "in",
            "not_in",
            "contains",
            "contains_any",
            "contains_all",
            "is_true",
            "is_false",
            "manual_review",
            "unstructured_nlp"
          ],
          "description": "Evaluation operator."
        },
        "expected_value": {
          "description": "Target boundary value (scalar, array, range object, or null)."
        },
        "value_type": {
          "type": "string",
          "enum": [
            "numeric",
            "string",
            "boolean",
            "list_string",
            "range",
            "unstructured"
          ],
          "description": "Primitive data type of the expected_value."
        },
        "logic_group": {
          "type": "string",
          "default": "DEFAULT",
          "description": "Identifier grouping multiple rules into a common logical block."
        },
        "required": {
          "type": "boolean",
          "description": "True if rule must be evaluated for eligibility assessment."
        },
        "hard_constraint": {
          "type": "boolean",
          "description": "True if failure of this single rule immediately disqualifies the applicant."
        },
        "condition": {
          "type": "object",
          "description": "Structured condition AST expression for programmatic execution.",
          "required": ["field", "op", "val"],
          "properties": {
            "field": {"type": "string"},
            "op": {"type": "string"},
            "val": {},
            "unit": {"type": ["string", "null"]}
          }
        },
        "raw_text": {
          "type": "string",
          "description": "Exact statutory clause text from the original policy document."
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Authoritative portal URL of the scheme."
        },
        "source_document": {
          "type": "string",
          "description": "Name of the source dataset or document."
        },
        "source_page": {
          "type": ["integer", "null"],
          "description": "Page number if extracted from a PDF gazette, else null."
        },
        "source_section": {
          "type": "string",
          "enum": [
            "eligibility",
            "exclusions",
            "documents_required",
            "benefits",
            "application_process"
          ],
          "description": "Source metadata field or document chapter."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Extraction confidence score (1.0 = unambiguous deterministic rule)."
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_dataset",
            "extractor",
            "extraction_timestamp"
          ],
          "properties": {
            "source_dataset": {"type": "string"},
            "extractor": {"type": "string"},
            "extraction_timestamp": {"type": "string"},
            "review_status": {
              "type": "string",
              "enum": ["VERIFIED_DETERMINISTIC", "HEURISTIC_PARSED", "UNSTRUCTURED_REQUIRES_LLM_OR_MANUAL_REVIEW"]
            }
          }
        }
      }
    },
    "LogicGroup": {
      "type": "object",
      "required": ["group_id", "operator", "rule_ids"],
      "properties": {
        "group_id": {"type": "string"},
        "operator": {
          "type": "string",
          "enum": ["AND", "OR", "NOT"]
        },
        "rule_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "description": {"type": "string"}
      }
    }
  }
}
