# Scratch and temporary scripts
scratch/
temp/
tmp/

# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
build/
coverage/
.nyc_output/

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Intelligence Datasets & Bulk Storage
Intelligence/data/raw/*
!Intelligence/data/raw/.gitkeep
Intelligence/data/interim/*
!Intelligence/data/interim/.gitkeep
Intelligence/data/processed/*
!Intelligence/data/processed/.gitkeep
Intelligence/data/normalized/*
!Intelligence/data/normalized/.gitkeep
