# ==========================================
# FIN AI Module - Git Ignore Rules
# ==========================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/
.env/
.virtualenv/

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json
service_account.json

# --- Model Weights, Checkpoints & Artifacts ---
models/embeddings/*
!models/embeddings/.gitkeep
models/reranker/*
!models/reranker/.gitkeep
models/classifiers/*
!models/classifiers/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.ckpt
*.joblib
*.pkl
*.pickle
*.weights

# --- Vector Stores & Databases ---
vectorstore/*
!vectorstore/.gitkeep
!vectorstore/README.md
*.faiss
*.index
*.sqlite
*.sqlite3
chroma.sqlite3
*.chromadb/
chroma/
qdrant_storage/
weaviate_data/

# --- Datasets & Document Storage ---
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/normalized/*
!data/normalized/.gitkeep
# Ignore crawl snapshot dumps, candidate runs and reconciliation diffs
data/snapshots/snapshot_crawl_*.json
data/snapshots/rag_chunks_crawl_*.json
data/snapshots/reconciliation_diff.json
data/snapshots/candidates/
data/coverage/*
!data/coverage/.gitkeep
data/conflicts/*
!data/conflicts/.gitkeep
data/failures/*
!data/failures/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/lineage/*
!data/lineage/.gitkeep
data/evaluation/reports/*
!data/evaluation/reports/.gitkeep
data/schemes/documents/*
!data/schemes/documents/.gitkeep

# Exclude bulk document & dataset formats in data folders
*.pdf
*.docx
*.xlsx
*.csv
*.parquet
*.feather
*.tar
*.gz
*.zip
*.7z
*.npy
*.npz
data/processed/*.jsonl

# Retain tracked sample files and golden evaluation suites
!data/samples/**
!data/test_cases/**
!data/evaluation/*.jsonl
!data/snapshots/**/canonical/schemes.jsonl

# --- Temporary & Uploaded User Documents ---
scratch/
uploads/
tmp/
temp/
*.tmp
*.log

# --- Jupyter Notebooks & Prototyping ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Testing, Coverage & Profiling ---
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- IDEs & OS Specific Files ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
