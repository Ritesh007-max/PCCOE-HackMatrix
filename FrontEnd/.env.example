# FrontEnd Configuration for Vercel / Production
# Set this in Vercel to your deployed Render backend URL (e.g. https://pccoe-hackmatrix-backend.onrender.com)
VITE_API_URL=https://pccoe-hackmatrix-backend.onrender.com

# Clerk Authentication publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Security & Session Settings
VITE_SESSION_TIMEOUT_SEC=300
VITE_SESSION_WARNING_SEC=60
VITE_ENABLE_DEV_AUTH_BYPASS=false
