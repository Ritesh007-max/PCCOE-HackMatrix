# ===================================================
# PolicySetu AI Microservice - Environment Configuration Template
# Copy this file to .env and configure local secrets.
# ===================================================

# --- Application Runtime ---
AI_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=INFO
AI_DEBUG=true

# --- Service Authentication ---
AI_SERVICE_API_KEY=your_internal_service_api_key_here
BACKEND_SERVICE_URL=http://localhost:5000

# --- LLM Providers & API Keys ---
LLM_PROVIDER=auto

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Default Model Identifiers ---
DEFAULT_LLM_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---
DEFAULT_EMBEDDING_MODEL=
LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- Reranker ---
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Vector Database & Storage ---
VECTORSTORE_BACKEND=chroma
VECTORSTORE_PERSIST_DIR=./vectorstore/chroma
FAISS_INDEX_PATH=./vectorstore/policy_index.faiss
CHROMA_COLLECTION_NAME=policysetu_schemes

# --- Storage & Data Directories ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_CACHE_DIR=./models

# --- Pipeline Parameters ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
SIMILARITY_THRESHOLD=0.72
