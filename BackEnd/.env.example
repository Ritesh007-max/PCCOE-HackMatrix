# BackEnd Server Configuration for Render / Production
PORT=5000

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_ROLE_KEY=your-supabase-anon-key
SUPABASE_DOCUMENTS_BUCKET=documents

# Allowed frontend origins for CORS (comma-separated, or * for all, or your Vercel URL)
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend-project.vercel.app

# Optional Python AI Engine URL (falls back to built-in rules if not set or offline)
AI_SERVER_URL=http://127.0.0.1:8000
